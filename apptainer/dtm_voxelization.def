Bootstrap: docker
From: ubuntu:24.04

# Image for dtm_voxelization. The dependencies live in the image; the CODE
# does not -- the repository is bind-mounted at /workspace when the container
# runs (see apptainer/shell.sh), so edits on the host take effect immediately
# without rebuilding. PYTHONPATH below is what makes the bind-mounted source
# importable.
#
# PoRePy is not on PyPI, so it is cloned and installed from GitHub. Set
# POREPY_REPO/POREPY_BRANCH in %post to build against a fork or a fixed tag.

%labels
    Name dtm_voxelization
    Description Voxelize a real DTM into a carved PorePy Cartesian grid

%environment
    export VENV=/opt/venv
    export PATH=${VENV}/bin:${PATH}
    export PROJECT_DIR=/workspace
    export PYTHONPATH=/workspace/src${PYTHONPATH:+:${PYTHONPATH}}
    # no display inside the container: keep matplotlib (pulled in by PorePy)
    # from trying to open one
    export MPLBACKEND=Agg

%post
    set -e

    export DEBIAN_FRONTEND=noninteractive
    VENV=/opt/venv
    POREPY_REPO=https://github.com/pmgbergen/porepy.git
    POREPY_BRANCH=develop

    apt-get update -y
    apt-get install -y --no-install-recommends \
        python3 python3-dev python3-venv \
        build-essential git ca-certificates \
        libgomp1 \
        vim less
    # the gmsh wheel PorePy depends on links against these even when used
    # purely headlessly
    apt-get install -y --no-install-recommends \
        libgl1 libglu1-mesa libxrender1 libxcursor1 libxft2 libxinerama1
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python3 -m venv ${VENV}
    ${VENV}/bin/pip install --no-cache-dir --upgrade pip setuptools wheel

    git clone --depth 1 --branch ${POREPY_BRANCH} ${POREPY_REPO} /opt/porepy
    ${VENV}/bin/pip install --no-cache-dir /opt/porepy

    # dtm_voxelization's own dependencies; PorePy already brings numpy, scipy
    # and meshio, they are named here so the image stands on its own
    ${VENV}/bin/pip install --no-cache-dir numpy scipy meshio

    # the console scripts from pyproject.toml's [project.scripts], as thin
    # wrappers -- keep this list in step with that table
    for entry in \
        "dtm-voxelization:build_cartgrid_carved" \
        "dtm-voxelization-refined:build_cartgrid_carved_refined" \
        "dtm-export-planes:export_planes_stl" \
        "dtm-align-surface:align_surface" \
        "dtm-cut-surface:cut_surface" \
        "dtm-detach-cells:detach_cells" ; do
        name=${entry%%:*}
        module=${entry##*:}
        printf '#!/bin/sh\nexec python -m dtm_voxelization.%s "$@"\n' "${module}" \
            > /usr/local/bin/${name}
        chmod +x /usr/local/bin/${name}
    done

    # mount points for the bind-mounted repository, data and output
    mkdir -p /workspace /workspace/data /workspace/output

%runscript
    cd ${PROJECT_DIR:-/workspace}
    if [ $# -eq 0 ]; then
        exec /bin/bash
    fi
    exec "$@"

%test
    python -c "import numpy, scipy, meshio, porepy; print('porepy', porepy.__version__)"

%help
    dtm_voxelization -- voxelize a real DTM into a carved PorePy grid.

    The code is NOT baked into the image: bind the repository at /workspace.
    apptainer/shell.sh does that for you, including a separately bindable
    output folder:

        apptainer/shell.sh                        # shell, output in the repo
        apptainer/shell.sh -o /scratch/out        # shell, output elsewhere
        apptainer/shell.sh -- dtm-cut-surface     # run one command and exit

    Inside, these are on PATH: dtm-voxelization, dtm-voxelization-refined,
    dtm-export-planes, dtm-align-surface, dtm-cut-surface, dtm-detach-cells.
    Equivalently, and always correct: python -m dtm_voxelization.<module>
