Bootstrap: docker
From: ubuntu:24.04

# Image for dtm_voxelization. The dependencies live in the image; the CODE
# does not -- the repository is bind-mounted at /workspace when the container
# runs (see apptainer/shell.sh), so edits on the host take effect immediately
# without rebuilding. PYTHONPATH below is what makes the bind-mounted source
# importable.

%labels
    Name dtm_voxelization
    Description Refined, terrain-carved hex grids of a DTM, split along fractures and exported for SPEED

%environment
    export VENV=/opt/venv
    export PATH=${VENV}/bin:${PATH}
    export PROJECT_DIR=/workspace
    export PYTHONPATH=/workspace/src${PYTHONPATH:+:${PYTHONPATH}}

%post
    set -e

    export DEBIAN_FRONTEND=noninteractive
    VENV=/opt/venv

    apt-get update -y
    apt-get install -y --no-install-recommends \
        python3 python3-venv ca-certificates vim less
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python3 -m venv ${VENV}
    ${VENV}/bin/pip install --no-cache-dir --upgrade pip
    ${VENV}/bin/pip install --no-cache-dir numpy scipy meshio

    # the console script from pyproject.toml, as a thin wrapper
    printf '#!/bin/sh\nexec python -m dtm_voxelization "$@"\n' > /usr/local/bin/dtm-voxelization
    chmod +x /usr/local/bin/dtm-voxelization

    # mount points for the bind-mounted repository, data and output
    mkdir -p /workspace /workspace/data /workspace/output

%runscript
    cd ${PROJECT_DIR:-/workspace}
    if [ $# -eq 0 ]; then
        exec /bin/bash
    fi
    exec "$@"

%test
    python -c "import tomllib, numpy, scipy, meshio; print('numpy', numpy.__version__, 'scipy', scipy.__version__, 'meshio', meshio.__version__)"

%help
    dtm_voxelization -- refined, terrain-carved hex grids of a DTM, split along
    fracture surfaces and exported for SPEED.

    The code is NOT baked into the image: bind the repository at /workspace.
    apptainer/shell.sh does that for you, including a separately bindable
    output folder:

        source apptainer/shell.sh                         # shell, output in the repo
        source apptainer/shell.sh -o /scratch/out         # shell, output elsewhere
        source apptainer/shell.sh -- dtm-voxelization cases/rialba.toml

    Inside: dtm-voxelization CASE.toml [STEP ...], or equivalently
    python -m dtm_voxelization CASE.toml [STEP ...]
